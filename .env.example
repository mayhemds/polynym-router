# Copy this file to .env and fill in the keys for the providers you actually use.
# Never commit the real .env file, it is already in .gitignore.

PORT=3000

# Optional. When set, POST /v1/ai and POST /v1/tasks require an
# "Authorization: Bearer <AUTH_TOKEN>" header. Leave empty to disable auth
# (the default, fine for localhost). Set it before exposing the router to
# anything other than your own machine.
AUTH_TOKEN=

# Only needed for models in config/models.json with "provider": "anthropic"
ANTHROPIC_API_KEY=

# Only needed for models with "provider": "openai_compatible" pointing at OpenAI
OPENAI_API_KEY=

# Only needed for models with "provider": "openai_compatible" pointing at Kimi/Moonshot
KIMI_API_KEY=

# Add more <PROVIDER>_API_KEY entries here as you add providers to config/models.json,
# then reference the same env var name in each model's "apiKeyEnv" field.

# Comma-separated absolute paths. Requests may only load .ai/ context from a
# project path inside one of these roots. Defaults to the current working
# directory if unset. This exists to stop a request from reading arbitrary
# files on the host by pointing projectPath somewhere unexpected.
ALLOWED_PROJECT_ROOTS=
